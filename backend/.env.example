MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/webprice
JWT_SECRET=<random-secret-min-32-chars>
PORT=5000

# Production frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# Email alerts (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM=PriceCompare <your@gmail.com>

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com

# Gemini AI (for chat assistant)
GEMINI_API_KEY=<gemini-api-key>

# Shopee (optional — scraper currently disabled)
SHOPEE_USER=
SHOPEE_PASS=
